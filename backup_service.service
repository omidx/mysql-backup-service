[Unit]
Description=MySQL Backup Service v2
Documentation=https://github.com/omidx/mysql-backup-service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mysql-backup-service --config /etc/mysql-backup-service/mysql-backup.conf run
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077

# Broadly compatible hardening. If you run native mode, consider changing
# User=root to a dedicated account with only backup/read permissions.
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Logs are written both to journald/stdout and (by default) to the configured
# rotating log file.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
